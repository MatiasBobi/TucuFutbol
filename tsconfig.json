{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "es6",
    "jsx": "react-jsx",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./*"
      ]
      
    },
    
    
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
