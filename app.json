{
  "expo": {
    "name": "TucuLive",
    "slug": "TucuLive",
    "runtimeVersion": "1.0.2",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tuculive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "enableProguardInReleaseBuilds": true,
      "permissions":["android.permission.POST_NOTIFICATIONS"],
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "package": "com.futapk_TucuLive",
      "androidNavigationBar": {
        "backgroundColor": "#041026",
        "barStyle": "light-content"
      },
      "androidStatusBar": {
        "backgroundColor": "#041026",
        "barStyle": "light-content",
        "translucent": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep public class com.futapk_TucuLive.** {*;}",
            "allowBackup": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
      
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6bcaa70-463c-4c94-9653-a1c7a5a964c5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e6bcaa70-463c-4c94-9653-a1c7a5a964c5"
    }
  }
}
